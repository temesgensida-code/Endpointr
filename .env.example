# ── Django ───────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────────
# Leave blank to use SQLite (development default).
# DATABASE_URL=postgres://endpointr:endpointr@localhost:5432/endpointr

# TimescaleDB — only needed when metrics-service is running.
# TIMESCALE_DSN=postgres://endpointr:endpointr@localhost:5433/endpointr_metrics

# ── Redis ─────────────────────────────────────────────────────────────────────
# Leave blank to use InMemory channel layer (development default).
# REDIS_URL=redis://localhost:6379/0

# ── NATS ─────────────────────────────────────────────────────────────────────
# Leave blank — events are logged locally (no Go services needed for dev).
# NATS_URL=nats://localhost:4222

# ── Single User Mode ─────────────────────────────────────────────────────────
# Auth is handled internally by SingleUserAuthentication (no Clerk tenant required).


# ── AI / Gemini ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
CHAT_MEMORY_TURNS=12

# ── Go execution-service ──────────────────────────────────────────────────────
# (only needed when running Go services separately)
# CONTROL_PLANE_URL=http://localhost:8000
